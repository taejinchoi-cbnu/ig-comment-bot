{
  "name": "@ig/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test:db": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.dbtest.ts\"",
    "build:lambda": "esbuild src/lambda/http.ts src/lambda/sqs.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist-lambda --entry-names='[name]' --external:@nestjs/microservices --external:@nestjs/websockets --external:class-validator --external:class-transformer"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1117.0",
    "@aws-sdk/client-sqs": "^3.1117.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prisma": "7",
    "typescript": "5.9.3"
  }
}
