# 이 파일은 .gitignore 됨 (/ops/). 절대 커밋되지 않습니다.

# ── Neon ────────────────────────────────────────────────────────
# Connect 다이얼로그에서 두 개 다 필요합니다.
#  · DATABASE_URL          → 풀링 ON.  호스트에 "-pooler" 가 있어야 함  (앱 런타임)
#  · DATABASE_URL_UNPOOLED → 풀링 OFF. "-pooler" 가 없어야 함          (prisma migrate)
# 두 줄의 호스트명이 같으면 잘못 복사한 겁니다.

DATABASE_URL=postgresql://user:pw@ep-xxx-pooler.REGION.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pw@ep-xxx.REGION.aws.neon.tech/db?sslmode=require

# ── AWS 배포 (싱가포르 — Neon과 같은 리전) ──────────────────────────────
AWS_PROFILE=ig-bot
AWS_REGION='ap-southeast-1'
STACK_NAME=ig-comment-bot-dev
ARTIFACT_BUCKET='ig-comment-bot-artifacts-311912733888-ap-southeast-1'

# ── Phase 2 이후 채웁니다 ───────────────────────────────────────
WEB_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
