# 이 파일은 .gitignore 됨 (/ops/). 절대 커밋되지 않습니다.

# ── Neon ────────────────────────────────────────────────────────
# Connect 다이얼로그에서 두 개 다 필요합니다.
#  · DATABASE_URL          → 풀링 ON.  호스트에 "-pooler" 가 있어야 함  (앱 런타임)
#  · DATABASE_URL_UNPOOLED → 풀링 OFF. "-pooler" 가 없어야 함          (prisma migrate)
# 두 줄의 호스트명이 같으면 잘못 복사한 겁니다.
#
# sslmode 는 Neon 이 주는 `require` 가 아니라 **`verify-full` 로 바꿔 적습니다.**
# node-postgres 는 지금 `require` 를 `verify-full` 의 별칭으로 처리하지만(즉 인증서를
# 완전 검증), pg v9 부터 libpq 의미로 바뀌어 검증이 **조용히 꺼집니다**. 명시해 두면
# 의존성 범프 한 번에 DB 연결이 MITM 에 열리는 일이 없습니다. 지금 동작은 완전히 동일합니다.

DATABASE_URL=postgresql://user:pw@ep-xxx-pooler.REGION.aws.neon.tech/db?sslmode=verify-full
# 로컬 개발용 마스터 키. openssl rand -base64 32
MASTER_KEY=''
DATABASE_URL_UNPOOLED=postgresql://user:pw@ep-xxx.REGION.aws.neon.tech/db?sslmode=verify-full

# ── AWS 배포 (싱가포르 — Neon과 같은 리전) ──────────────────────────────
AWS_PROFILE=ig-bot
AWS_REGION='ap-southeast-1'
STACK_NAME=ig-comment-bot-dev
ARTIFACT_BUCKET='ig-comment-bot-artifacts-ACCOUNT_ID-ap-southeast-1'
# dev 또는 prod. STACK_NAME 을 prod 로 바꾸면 이것도 반드시 같이 바꾸세요 —
# 안 그러면 "prod" 스택이 dev 의 Secrets Manager 항목(ig-comment-bot/dev/app)을
# 계속 참조합니다. 생략하면 dev.
ENVIRONMENT=dev

# ── Phase 2 이후 채웁니다 ───────────────────────────────────────
WEB_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
